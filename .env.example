# Copy this file to .env before running docker compose up.
# Never commit the real .env — only .env.example is tracked.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=dhaka_tesla_pool
MYSQL_USER=teslapool
MYSQL_PASSWORD=change_me_app

# --- Backend (Express) ---
PORT=4000
DB_HOST=mysql
DB_PORT=3306
DB_USER=teslapool
DB_PASSWORD=change_me_app
DB_NAME=dhaka_tesla_pool
JWT_SECRET=change_me_to_a_long_random_string

# --- Frontend (Vite) ---
# The URL the BROWSER uses to reach the API — localhost, not the "backend"
# Docker service name, since this is baked into the static build the
# browser downloads.
VITE_API_URL=http://localhost:4000/api
